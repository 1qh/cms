---
import Base from '@/layouts/Base.astro'
import { getPosts, getCategories } from '@/lib/content'

const posts = getPosts()
const categories = getCategories()
const categoryMap = new Map(categories.map((c) => [c.slug, c.title]))
---

<Base title="Họ Lại Việt Nam">
  <h1 class="text-3xl font-heading font-bold mb-8">Bài viết mới nhất</h1>
  <ul class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
    {posts.slice(0, 12).map((post) => (
      <li>
        <a href={`/${post.category}/${post.slug}`} class="group block space-y-3">
          {post.coverUrl && (
            <img
              src={post.coverUrl}
              alt={post.title}
              loading="lazy"
              class="aspect-[3/2] w-full object-cover rounded-lg bg-muted"
            />
          )}
          <time class="text-xs text-muted-foreground">{post.date}</time>
          <h2 class="font-medium leading-snug group-hover:text-primary/70 transition-colors line-clamp-2">
            {post.title}
          </h2>
          <span class="text-xs text-muted-foreground">
            {categoryMap.get(post.category)}
          </span>
        </a>
      </li>
    ))}
  </ul>
</Base>
